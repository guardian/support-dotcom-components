{
    "extends": "./tsconfig",
    "compilerOptions": {
        "target": "ES2020",
        "rootDir": "src",
        "outDir": "src/dotcom/dist",
        "declaration": true,
        "declarationMap": true,
        "isolatedModules": false,
        "noEmit": false,
        "allowJs": false,
        "emitDeclarationOnly": true
    },
    "exclude": ["**/*.test.ts", "dist/**/*", "src/dotcom/dist/**/*", "src/server/**/*"],
    "files": ["./src/dotcom/index.ts", "./src/dotcom/types.ts"]
}
