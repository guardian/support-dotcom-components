{
    "compilerOptions": {
        "module": "ESNext",
        "target": "ES2020",
        "esModuleInterop": true,
        "moduleResolution": "Bundler",
        "sourceMap": true,
        "strict": true,
        "types": ["jest", "node"]
    },
    "include": [
        "src/**/*",
        "**/*.test.ts",
        "**/*.spec.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
